<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>ChineseLearningApp</Company>
    <Product>Chinese Learning App</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Full word list a fresh install starts with (no vocabulary.json yet). -->
    <EmbeddedResource Include="Data\vocabulary-starter.json" LogicalName="ChineseLearningApp.vocabulary-starter.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChineseLearning.Sync\ChineseLearning.Sync.csproj" />
  </ItemGroup>

</Project>