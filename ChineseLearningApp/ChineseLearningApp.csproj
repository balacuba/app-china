<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>ChineseLearningApp</Company>
    <Product>Chinese Learning App</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Full word list a fresh install starts with (no vocabulary.json yet). -->
    <EmbeddedResource Include="Data\vocabulary-starter.json" LogicalName="ChineseLearningApp.vocabulary-starter.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChineseLearning.Sync\ChineseLearning.Sync.csproj" />
    <!-- The study website runs inside the app (StudyWebsite.cs). -->
    <ProjectReference Include="..\ChineseLearningServer\ChineseLearningServer.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The website's pages, served from wwwroot beside the app. -->
    <Content Include="..\ChineseLearningServer\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>