<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChineseLearning.Sync\ChineseLearning.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same word list the desktop app ships with, served at /api/vocabulary. -->
    <None Include="..\ChineseLearningApp\Data\vocabulary-starter.json" Link="Data\vocabulary-starter.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
